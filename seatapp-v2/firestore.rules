rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /classes/{classId} {
      // 반 메타정보(이름/교실크기/좌석배치도/제약조건/가중치/roster 이름목록)는
      // 그 반 담당 선생님(소유자) + 그 반 소속 학생(커스텀 클레임)만 읽을 수 있음.
      // roster에는 이름만 있고, MBTI/성적 등 설문 응답은 여기 없음 (students 서브컬렉션에만 있음).
      allow read: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid ||
        (request.auth.token.role == 'student' && request.auth.token.classId == classId)
      );
      allow create: if request.auth != null && request.auth.token.role != 'student'
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherUid == request.auth.uid
                    && request.auth.token.role != 'student';

      match /students/{number} {
        // 학생 설문 응답 원본. 본인만 읽고 쓸 수 있음. 선생님(teacherUid 소유자)도 여기는 절대 read 불가.
        allow read: if request.auth != null && request.auth.token.role == 'student'
                    && request.auth.token.classId == classId && request.auth.token.number == number;
        allow update: if request.auth != null && request.auth.token.role == 'student'
                    && request.auth.token.classId == classId && request.auth.token.number == number
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'mbti','eyesight','grade','height','preferredLocation','aircon',
                      'activity','preferredMates','avoidedMate','memo','submitted','updatedAt'
                    ]);
        // 생성/삭제는 서버(Admin SDK, create-students.js)에서만 수행 → 클라이언트 create/delete는 기본 거부
      }

      match /results/{doc} {
        // 최종 좌석 배치 결과(이름+번호+좌석위치만 있음, 원본 설문 데이터 없음). 선생님만 열람.
        allow read: if request.auth != null && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        // 쓰기는 서버(Admin SDK, run-seating.js)에서만 수행 → 클라이언트 쓰기 기본 거부
      }
    }
  }
}
